        "jsCode": "const response = $json || {};\nif (response.errors?.length) throw new Error(response.errors.map(error => error.message).join(' | '));\nconst product = response.data?.product;\nif (!product?.id) throw new Error('Produto não encontrado no Shopify.');\nconst input = (product.resourcePublications?.nodes || [])\n  .map(item => item?.publication?.id)\n  .filter(Boolean)\n  .map(publicationId => ({ publicationId }));\nreturn { product_id: product.id, input };"
