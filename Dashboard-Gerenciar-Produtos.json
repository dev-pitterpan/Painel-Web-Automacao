        "jsCode": "const request = $input.first().json || {};\nconst body = request.body || request;\nconst headers = request.headers || {};\nconst TOKEN_ESPERADO = 'pitterpan-dashboard-2026-token-seguro-8472';\nconst token = String(headers['x-pitterpan-token'] || headers['X-Pitterpan-Token'] || '').trim();\nif (!token || token !== TOKEN_ESPERADO) throw new Error('Token inválido.');\nconst action = String(body.action || '').trim().toLowerCase();\nif (!['archive', 'unpublish', 'delete'].includes(action)) throw new Error('Ação inválida.');\nconst source = Array.isArray(body.products) ? body.products : [];\nconst productPrefix = 'gid://shopify/Product/';\nconst products = [...new Map(source.map(item => {\n  const id = String(item?.shopify_id || '').trim();\n  return [id, { id, sku: String(item?.sku || '').trim(), title: String(item?.title || '').trim() }];\n}).filter(([id]) => id.startsWith(productPrefix) && /^\\d+$/.test(id.slice(productPrefix.length)))).values()].slice(0, 250);\nif (!products.length) throw new Error('Nenhum produto válido recebido.');\nreturn products.map(product => ({ json: {\n  action,\n  product,\n  request_id: String(body.request_id || ''),\n} }));"
