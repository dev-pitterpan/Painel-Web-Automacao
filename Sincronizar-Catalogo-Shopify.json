        "jsonBody": "={{ { query: `query Catalogo($after: String) { products(first: 25, after: $after, sortKey: UPDATED_AT) { nodes { id title handle status vendor productType tags updatedAt totalInventory featuredMedia { ... on MediaImage { image { url altText } } } collections(first: 20) { nodes { title } } variants(first: 10) { nodes { id title sku price inventoryQuantity } } } pageInfo { hasNextPage endCursor } } }`, variables: { after: $json.cursor || null } } }}",
        "options": {}
      },
